NODE_ENV=development
# Local Docker Postgres. For Supabase use the CONNECTION POOLER, not the
# db.*.supabase.co host - that one is IPv6-only and unreachable from Vercel:
#   DATABASE_URL="postgresql://postgres.<ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.<ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Percent-encode the password: `&` becomes %26 and `%` becomes %25.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roommate_match?schema=public"
# Session-mode connection used only by `prisma migrate`. Leave unset locally.
# DIRECT_URL=
JWT_SECRET="replace-this-with-a-long-random-secret"
# Default host port is 18888 (not 8888) because Windows/Hyper-V often dynamically excludes
# the 8875-8974 TCP range, which makes binding to 8888 fail with EACCES. If you're not on
# Windows and 8888 is free, you can change this back.
PORT=18888
ADMIN_EMAIL="admin@sut.ac.th"

# Allows OTP code 123456 and echoes otp/resetToken back in API responses for local testing.
# Must never be true in production - main.ts refuses to boot if NODE_ENV=production and this is true.
ALLOW_DEV_OTP=true
GOOGLE_CLIENT_IDS="your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com"

# Which storage backend handles uploaded images: `minio` or `supabase`.
# Left unset, Supabase is used when its S3 settings below are present, and MinIO
# otherwise - so a developer machine needs no extra configuration.
# STORAGE_DRIVER=minio

# Supabase Storage, over its S3-compatible API. The bucket must be marked
# PUBLIC in the Supabase dashboard, or uploaded images will not load.
# SUPABASE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=ap-southeast-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_BUCKET=roommate-match

# MinIO Config
# Default host port is 19000 (not MinIO's usual 9000) because Windows/Docker Desktop often has
# 9000 blocked by a Hyper-V dynamic port exclusion range. If you're not on Windows and 9000 is
# free, you can change this back to 9000 (and update docker-compose.yml to match).
MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=roommate-match
# Prefix used to construct public URLs, e.g. for phone testing or proxying
# MINIO_PUBLIC_URL_PREFIX=http://192.168.1.55:9000/roommate-match

# Comma-separated domains an account may register from. Admins can override
# this at runtime from the app (Admin > Configuration); this is the seed value.
ALLOWED_EMAIL_DOMAINS=g.sut.ac.th,sut.ac.th

# Required in production: origins allowed to call the API from a browser.
# Native builds send no Origin header, so they work without this.
# CORS_ORIGINS=https://app.example.com

# Swagger is served at /api/docs in development. Set to true to expose it in
# production as well (it is off there by default).
# ENABLE_SWAGGER=false

# --- Verification code delivery -------------------------------------------
# Three options, in the order the API tries them:
#
# 1. Supabase. Set both of these and Supabase generates the code and emails it
#    with the SMTP settings from its dashboard. Two dashboard steps are needed
#    as well, or the mail goes out as a login link with no code in it:
#      - Authentication > Emails: put {{ .Token }} in the "Magic Link" and
#        "Confirm signup" templates.
#      - Authentication > Rate Limits: raise "Rate limit for sending emails"
#        past the default, which is low.
# SUPABASE_URL=https://<ref>.supabase.co
# Project Settings > API. Newer projects issue `sb_publishable_...`; older ones
# a legacy `anon` JWT. Either works - never use a secret/service_role key here.
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
#
# 2. Resend, if the Supabase settings are absent.
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
#
# 3. Neither: the code is written to the server log, which is how local
#    development works without a mailbox.

# `npm run db:seed` only creates the demo students when this is true.
# SEED_DEMO_USERS=false
# SEED_DEMO_PASSWORD=demo-password-123
